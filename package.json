{
  "name": "orange-textile",
  "description": "O'range Textile public website for overseas knit fabric sourcing.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:components": "vitest run",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "dev": "next dev",
    "dev:poll": "WATCHPACK_POLLING=1 next dev",
    "dev:clean": "rm -rf .next node_modules/.cache && WATCHPACK_POLLING=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:html-density": "node scripts/measure-production-density.mjs",
    "test:seo:production": "node scripts/run-production-seo-audit.mjs",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "14.2.33",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.33",
    "jsdom": "26.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vercel": "^50.37.3",
    "vitest": "3.2.4"
  }
}
